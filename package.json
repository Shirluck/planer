{
  "name": "planer-desktop",
  "version": "1.0.0",
  "description": "Планер: день, неделя, основные планы и идеи",
  "author": "Planer",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "playwright test --project=app",
    "test:packaged": "playwright test --project=packaged",
    "icons": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "local.planer.desktop",
    "productName": "Планер",
    "files": [
      "main.js",
      "preload.js",
      "shim.js",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office"
    }
  }
}
