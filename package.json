{
  "name": "planer-desktop",
  "version": "2.3.0",
  "description": "Планер: день, неделя, основные планы, идеи и доски задач",
  "author": "Planer",
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "playwright test --project=app",
    "test:packaged": "playwright test --project=packaged",
    "icons": "node scripts/make-icon.js",
    "dist": "electron-builder",
    "dist:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5"
  },
  "build": {
    "appId": "local.planer.desktop",
    "productName": "Планер",
    "executableName": "Planer",
    "copyright": "© 2026 Planer",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "shim.js",
      "index.html",
      "lib/**/*.js",
      "src/**/*.{js,css}",
      "build/icon.png",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Planer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Планер",
      "uninstallDisplayName": "Планер ${version}",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "multiLanguageInstaller": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Planer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Planer-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Planer-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Planer-${version}.${ext}"
    }
  }
}
