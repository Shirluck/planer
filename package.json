{
  "name": "planer-desktop",
  "version": "2.10.0",
  "description": "Планер — личный планировщик для Windows: календарь задач, доски в стиле Milanote, таймеры для фокусировки и ИИ-ассистент",
  "author": "Shirluck (https://github.com/Shirluck)",
  "license": "MIT",
  "homepage": "https://github.com/Shirluck/planer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shirluck/planer.git"
  },
  "bugs": {
    "url": "https://github.com/Shirluck/planer/issues"
  },
  "keywords": [
    "planner",
    "electron",
    "desktop",
    "milanote",
    "board",
    "timer",
    "pomodoro",
    "russian"
  ],
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "npm run typecheck && npm run test:unit && npm run test:e2e",
    "typecheck": "tsc -p .",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "playwright test --project=app",
    "test:packaged": "node scripts/packaged-check.js && playwright test --project=packaged",
    "icons": "node scripts/make-icon.js",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir",
    "release": "node scripts/release.js"
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "@playwright/test": "1.65.1",
    "electron": "45.3.3",
    "electron-builder": "26.18.0",
    "png-to-ico": "3.0.2",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "build": {
    "publish": {
      "provider": "github",
      "owner": "Shirluck",
      "repo": "planer",
      "releaseType": "release"
    },
    "appId": "local.planer.desktop",
    "productName": "Планер",
    "executableName": "Planer",
    "copyright": "© 2026 Shirluck",
    "asar": true,
    "electronLanguages": [
      "ru",
      "en-US"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": true
    },
    "files": [
      "main.js",
      "preload.js",
      "shim.js",
      "index.html",
      "mini.html",
      "lib/**/*.js",
      "src/**/*.{js,css}",
      "build/icon.png",
      "build/icon.ico",
      "package.json",
      "!**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Planer-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Планер",
      "uninstallDisplayName": "Планер ${version}",
      "installerLanguages": [
        "ru_RU",
        "en_US"
      ],
      "language": "1049",
      "multiLanguageInstaller": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false,
      "artifactName": "Planer-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Planer-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "artifactName": "Planer-${version}.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png",
      "artifactName": "Planer-${version}.${ext}"
    }
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
